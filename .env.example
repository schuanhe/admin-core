# 复制为 .env，并用独立密码管理器或 scripts/init-dev.ps1 生成随机密钥。
# 这两个占位值不能用于生产；至少32个随机字符，不得相同。
CONTROLLER_BOOTSTRAP_TOKEN=replace-with-a-unique-random-bootstrap-secret
CONTROLLER_REGISTRATION_KEY=replace-with-a-different-random-registration-secret
CONTROLLER_PUBLIC_ORIGIN=http://localhost:8080
# 生产使用HTTPS反向代理时必须改为true，并同步修改 PUBLIC_ORIGIN。
CONTROLLER_SECURE_COOKIE=false
# 精确的 scheme://host:port 白名单。仅中心需要访问，浏览器不连接业务服务。
CONTROLLER_ALLOWED_SERVICE_ORIGINS=http://127.0.0.1:8091
CONTROLLER_SESSION_HOURS=12
CONTROLLER_CHECK_INTERVAL_SECONDS=30
# 业务密钥通过只读文件注入；空值禁用业务网关。不要把文件复制到镜像。
CONTROLLER_SERVICE_ACCESS_FILE=/run/secrets/service-access.json
# Compose默认仅绑定本机。需要访问时请配置HTTPS入口，而非直接暴露HTTP。
CONTROLLER_BIND=127.0.0.1
CONTROLLER_PORT=8080

